# Copy to .env and edit. .env is gitignored: it holds machine-specific paths,
# and the archive it points at is not ours to redistribute.
#
# Resolution order throughout:
#   command line  >  a non-empty CBDB_* environment variable  >  .env  >  default
# so a CI job can override without editing anyone's file.


# ---------------------------------------------------------------------------
# Input
# ---------------------------------------------------------------------------
# The upstream release archive (.7z or .zip). Point it anywhere -- a Dropbox
# folder, a network share -- so a 200 MB input need not be copied into the
# repository. Leave it unset to use the single .7z/.zip in the repository root.
#
# On Windows, backslashes are fine and quotes are optional:
#CBDB_ARCHIVE=C:\Users\you\Dropbox\CBDB\CBDB Desktop\CBDB-Desktop_20260915.7z


# ---------------------------------------------------------------------------
# Icon
# ---------------------------------------------------------------------------
# Where the favicon shipped inside each distribution comes from.
#
# true  (default) take an .ico from the upstream payload root. That is the
#                 artwork the CBDB project actually maintains, so it stays
#                 current without anyone editing this repository. If the
#                 payload ships no .ico the build STOPS and says so -- it does
#                 not quietly fall back, because silently shipping the wrong
#                 branding is worse than a failed build.
# false           use crossbuild/assets/favicon.ico, generated from LOGO.png
#                 by make-favicon.py. Set this by hand when upstream ships no
#                 icon, or when you want this repository's version.
CBDB_USE_INPUT_ICON=true

# Which one, when the payload holds more than one. Matched case-insensitively
# against the .ico files in the payload root. Leave unset when there is exactly
# one; the build fails rather than guessing when there are several.
#
# Overridable per run: --icon NAME also implies "use the input icon", and
# --no-input-icon forces the committed one.
# Commented out on purpose: a live value here would make the documented
# `copy .env.sample .env` quick start fail for anyone whose payload does
# not happen to hold a file of exactly this name.
#CBDB_INPUT_ICON=CBDBLogoWhiteBackground.ico
